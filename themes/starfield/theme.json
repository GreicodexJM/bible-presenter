{
  "name": "Starfield",
  "background": {
    "type": "shader",
    "vertexShader": "starfield.vert",
    "fragmentShader": "starfield.frag",
    "uniforms": {
      "time": { "type": "float", "value": 0.0 },
      "resolution": { "type": "vec2", "value": [1920, 1080] }
    },
    "textures": [],
    "animationClass": "cosmic-drift"
  },
  "input": {
    "backgroundImage": "input.svg",
    "position": { "x": "auto", "y": "35%" },
    "size": { "width": "60%", "height": "10%" },
    "enterClass": "cosmic-enter",
    "enterActiveClass": "cosmic-enter-active",
    "exitClass": "cosmic-exit",
    "exitActiveClass": "cosmic-exit-active"
  },
  "verse": {
    "backgroundImage": "verse.svg",
    "position": { "x": "auto", "y": "65%" },
    "size": { "width": "80%", "height": "30%" },
    "enterClass": "stellar-enter",
    "enterActiveClass": "stellar-enter-active",
    "exitClass": "stellar-exit",
    "exitActiveClass": "stellar-exit-active"
  },
  "transitions": {
    "fadeDuration": 1200,
    "easing": "ease-in-out"
  }
}
