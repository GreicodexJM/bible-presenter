{
  "name": "Jet Stream",
  "background": {
    "type": "shader",
    "vertexShader": "jetstream.vert",
    "fragmentShader": "jetstream.frag",
    "uniforms": {
      "time": { "type": "float", "value": 0.0 },
      "resolution": { "type": "vec2", "value": [1920, 1080] }
    },
    "textures": [
      "Noise.png"
    ],
    "animationClass": "atmospheric-flow"
  },
  "input": {
    "backgroundImage": "input.svg",
    "position": { "x": "50%", "y": "35%" },
    "size": { "width": "60%", "height": "10%" },
    "enterClass": "input-enter",
    "enterActiveClass": "input-enter-active",
    "exitClass": "input-exit",
    "exitActiveClass": "input-exit-active"
  },
  "verse": {
    "backgroundImage": "verse.svg",
    "position": { "x": "50%", "y": "65%" },
    "size": { "width": "80%", "height": "30%" },
    "enterClass": "verse-enter",
    "enterActiveClass": "verse-enter-active",
    "exitClass": "verse-exit",
    "exitActiveClass": "verse-exit-active"
  },
  "transitions": {
    "fadeDuration": 1000,
    "easing": "ease-in-out"
  }
}
