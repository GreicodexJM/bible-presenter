{
  "name": "Fire",
  "background": {
    "type": "shader",
    "vertexShader": "fire.vert",
    "fragmentShader": "fire.frag",
    "uniforms": {
      "iTime": { "type": "float", "value": 0.0 },
      "iResolution": { "type": "vec2", "value": [1920, 1080] },
      "iMouse": { "type": "vec4", "value": [0, 0, 0, 0] }
    },
    "textures": [],
    "animationClass": "fire-motion"
  },
  "input": {
    "backgroundImage": "input.svg",
    "position": { "x": "50%", "y": "35%" },
    "size": { "width": "60%", "height": "10%" },
    "enterClass": "heat-enter",
    "enterActiveClass": "heat-enter-active",
    "exitClass": "heat-exit",
    "exitActiveClass": "heat-exit-active"
  },
  "verse": {
    "backgroundImage": "verse.svg",
    "position": { "x": "50%", "y": "65%" },
    "size": { "width": "80%", "height": "30%" },
    "enterClass": "heat-enter",
    "enterActiveClass": "heat-enter-active",
    "exitClass": "heat-exit",
    "exitActiveClass": "heat-exit-active"
  },
  "transitions": {
    "fadeDuration": 1000,
    "easing": "ease-out"
  }
}
