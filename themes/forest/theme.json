{
  "name": "Forest",
  "background": {
    "type": "shader",
    "vertexShader": "default.vert",
    "fragmentShader": "forest.frag",
    "uniforms": {
      "time": { "type": "float", "value": 0.0 },
      "resolution": { "type": "vec2", "value": [1920, 1080] }
    },
    "textures": [],
    "animationClass": "fade-in"
  },
  "input": {
    "template": "input.svg",
    "position": { "x": "50%", "y": "40%" },
    "size": { "width": "60%", "height": "10%" },
    "animationClass": "slide-up"
  },
  "verse": {
    "template": "verse.svg",
    "position": { "x": "50%", "y": "60%" },
    "size": { "width": "80%", "height": "30%" },
    "animationClass": "fade-in-scale"
  },
  "transitions": {
    "fadeDuration": 500,
    "easing": "ease-in-out"
  }
}
