{
  "name": "Forest",
  "background": {
    "type": "shader",
    "vertexShader": "default.vert",
    "fragmentShader": "forest.frag",
    "uniforms": {
      "time": { "type": "float", "value": 0.0 },
      "resolution": { "type": "vec2", "value": [1920, 1080] }
    },
    "textures": [],
    "animationClass": "fade-in"
  },
  "input": {
    "backgroundImage": "input.svg",
    "position": { "x": "50%", "y": "40%" },
    "size": { "width": "60%", "height": "10%" },
    "enterClass": "slide-enter",
    "enterActiveClass": "slide-enter-active",
    "exitClass": "slide-exit",
    "exitActiveClass": "slide-exit-active"
  },
  "verse": {
    "backgroundImage": "verse.svg",
    "position": { "x": "50%", "y": "60%" },
    "size": { "width": "80%", "height": "30%" },
    "enterClass": "fade-enter",
    "enterActiveClass": "fade-enter-active",
    "exitClass": "fade-exit",
    "exitActiveClass": "fade-exit-active"
  },
  "transitions": {
    "fadeDuration": 500,
    "easing": "ease-in-out"
  }
}
