{
  "name": "Candle",
  "background": {
    "type": "shader",
    "vertexShader": "candle.vert",
    "fragmentShader": "candle.frag",
    "uniforms": {
      "iTime": { "type": "float", "value": 0.0 },
      "iResolution": { "type": "vec2", "value": [1920, 1080] },
      "iMouse": { "type": "vec4", "value": [0, 0, 0, 0] }
    },
    "textures": [],
    "animationClass": "candle-motion"
  },
  "input": {
    "backgroundImage": "input.svg",
    "position": { "x": "auto", "y": "35%" },
    "size": { "width": "60%", "height": "10%" },
    "enterClass": "glow-enter",
    "enterActiveClass": "glow-enter-active",
    "exitClass": "glow-exit",
    "exitActiveClass": "glow-exit-active"
  },
  "verse": {
    "backgroundImage": "verse.svg",
    "position": { "x": "auto", "y": "65%" },
    "size": { "width": "80%", "height": "30%" },
    "enterClass": "glow-enter",
    "enterActiveClass": "glow-enter-active",
    "exitClass": "glow-exit",
    "exitActiveClass": "glow-exit-active"
  },
  "transitions": {
    "fadeDuration": 1500,
    "easing": "ease-in-out"
  }
}
