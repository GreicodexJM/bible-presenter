{
  "name": "Lake Reflection",
  "background": {
    "type": "shader",
    "vertexShader": "lake.vert",
    "fragmentShader": "lake.frag",
    "uniforms": {
      "time": { "type": "float", "value": 0.0 },
      "resolution": { "type": "vec2", "value": [1920, 1080] }
    },
    "textures": [],
    "animationClass": "water-ripple"
  },
  "input": {
    "backgroundImage": "input.svg",
    "position": { "x": "auto", "y": "35%" },
    "size": { "width": "60%", "height": "10%" },
    "enterClass": "float-enter",
    "enterActiveClass": "float-enter-active",
    "exitClass": "float-exit",
    "exitActiveClass": "float-exit-active"
  },
  "verse": {
    "backgroundImage": "verse.svg",
    "position": { "x": "auto", "y": "65%" },
    "size": { "width": "80%", "height": "30%" },
    "enterClass": "water-enter",
    "enterActiveClass": "water-enter-active",
    "exitClass": "water-exit",
    "exitActiveClass": "water-exit-active"
  },
  "transitions": {
    "fadeDuration": 800,
    "easing": "ease-in-out"
  }
}
